# LSP (Language Server Protocol) configuration for AE-ADK quality gates.
# Generated by ae init / ae update — edit only language-specific overrides.
#
# Schema: lsp.servers.<language>
#   command:          LSP server executable name (required)
#   args:             Extra arguments passed to the server (optional)
#   file_extensions:  File extensions handled by this server (required, non-empty list)
#
# 16 languages supported: go, python, typescript, javascript, rust, java, kotlin,
# swift, ruby, php, cpp, csharp, scala, elixir, r, dart
#
# Note: "dart" key is used (NOT "flutter") per v1.2.0 specification.

lsp:
  servers:
    go:
      command: gopls
      args:
        - serve
      file_extensions:
        - .go

    python:
      command: pyright-langserver
      args:
        - --stdio
      file_extensions:
        - .py
        - .pyi

    typescript:
      command: typescript-language-server
      args:
        - --stdio
      file_extensions:
        - .ts
        - .tsx
        - .mts
        - .cts

    javascript:
      command: typescript-language-server
      args:
        - --stdio
      file_extensions:
        - .js
        - .jsx
        - .mjs
        - .cjs

    rust:
      command: rust-analyzer
      file_extensions:
        - .rs

    java:
      command: jdtls
      file_extensions:
        - .java

    kotlin:
      command: kotlin-language-server
      file_extensions:
        - .kt
        - .kts

    swift:
      command: sourcekit-lsp
      file_extensions:
        - .swift

    ruby:
      command: ruby-lsp
      file_extensions:
        - .rb
        - .rake
        - .gemspec

    php:
      command: intelephense
      args:
        - --stdio
      file_extensions:
        - .php
        - .phtml

    cpp:
      command: clangd
      file_extensions:
        - .cpp
        - .cc
        - .cxx
        - .hpp
        - .h

    csharp:
      command: omnisharp
      args:
        - --languageserver
      file_extensions:
        - .cs

    scala:
      command: metals
      file_extensions:
        - .scala
        - .sc

    elixir:
      command: elixir-ls
      file_extensions:
        - .ex
        - .exs

    r:
      command: languageserver
      file_extensions:
        - .r
        - .R

    dart:
      command: dart
      args:
        - language-server
        - --client-id=ae-adk
      file_extensions:
        - .dart
